rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if the current user has a specific role
    function isRole(role) {
      return isAuthenticated() && (
        (request.auth.token.role == role) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role)
      );
    }
    
    // Check if the current user is an admin
    function isAdmin() {
      return (request.auth.token.email == 'dawitf645@gmail.com' && request.auth.token.email_verified == true) || isRole('ADMIN');
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow users to update their own record, or admins to do anything.
      // We do not allow users to self-assign ADMIN unless bootstrapped.
      allow create: if (request.auth.uid == userId && (request.resource.data.role != 'ADMIN' || (request.auth.token.email == 'dawitf645@gmail.com' && request.auth.token.email_verified == true))) || isAdmin();
      allow update: if (request.auth.uid == userId && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }
    
    match /playerProfiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || request.auth.uid == userId;
    }
    
    match /coachProfiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || request.auth.uid == userId;
    }
    
    match /scoutProfiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || request.auth.uid == userId;
    }
    
    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.coachId == request.auth.uid);
      allow update: if isAuthenticated() && (isAdmin() || resource.data.coachId == request.auth.uid);
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.coachId == request.auth.uid);
    }
    
    match /accessIds/{accessId} {
      // Admins can read all access IDs.
      // Unauthenticated users (or any user) can get a specific access ID to validate it before signup.
      allow get: if true; 
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.status == 'UNUSED' && 
        request.resource.data.status == 'CONSUMED' && 
        request.resource.data.assignedUserId == request.auth.uid
      );
    }
    
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      
      match /modules/{moduleId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
        
        match /lessons/{lessonId} {
          allow read: if isAuthenticated();
          allow write: if isAdmin();
        }
      }
    }
    
    match /showcases/{showcaseId} {
      allow read: if isAuthenticated() || resource.data.status == 'APPROVED';
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.playerId == request.auth.uid);
      allow update: if isAuthenticated() && (isAdmin() || (resource.data.playerId == request.auth.uid && request.resource.data.status == resource.data.status));
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.playerId == request.auth.uid);
    }
    
    match /scholarships/{scholarshipId} {
      allow read: if true;
      allow create: if isAuthenticated() && (isAdmin() || (isRole('SCHOLARSHIP_PROVIDER') && request.resource.data.providerId == request.auth.uid));
      allow update, delete: if isAuthenticated() && (isAdmin() || (isRole('SCHOLARSHIP_PROVIDER') && resource.data.providerId == request.auth.uid));
    }
    
    match /contactInquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.providerId == request.auth.uid || resource.data.playerId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.playerId == request.auth.uid || request.resource.data.providerId == request.auth.uid);
      allow update: if isAuthenticated() && (isAdmin() || resource.data.providerId == request.auth.uid || resource.data.playerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /providerProfiles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || request.auth.uid == userId;
    }

    match /providerShortlists/{shortlistId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.providerId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.providerId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.providerId == request.auth.uid);
    }
    
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid in resource.data.participantIds);
      allow create: if isAuthenticated() && (isAdmin() || request.auth.uid in request.resource.data.participantIds);
      allow update: if isAuthenticated() && (isAdmin() || request.auth.uid in resource.data.participantIds);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          isAdmin() || 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
        );
        allow create: if isAuthenticated() && (
          isAdmin() || (
            request.resource.data.senderId == request.auth.uid &&
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          )
        );
        allow update: if isAuthenticated() && (
          isAdmin() || 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
        );
        allow delete: if isAdmin();
      }
    }
    
    match /conversationReports/{reportId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.reporterId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.senderId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.senderId == request.auth.uid);
    }
    
    match /training/{trainingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /playerProgress/{progressId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isAdmin() || progressId == request.auth.uid);

      match /trainingProgress/{drillId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (isAdmin() || progressId == request.auth.uid);
      }

      match /{document=**} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (isAdmin() || progressId == request.auth.uid);
      }
    }
    
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
    }
    
    match /scoutShortlists/{shortlistId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.scoutId == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.scoutId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.scoutId == request.auth.uid);
    }
    
    match /contactRequests/{requestId} {
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.scoutId == request.auth.uid || 
        resource.data.senderId == request.auth.uid || 
        resource.data.playerId == request.auth.uid ||
        resource.data.targetPlayerId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        isAdmin() || 
        request.resource.data.scoutId == request.auth.uid || 
        request.resource.data.senderId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isAdmin() || 
        resource.data.scoutId == request.auth.uid || 
        resource.data.senderId == request.auth.uid || 
        resource.data.playerId == request.auth.uid ||
        resource.data.targetPlayerId == request.auth.uid
      );
      allow delete: if isAdmin();
    }
    
    match /teamGroups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.coachId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.coachId == request.auth.uid);
    }
    
    match /trainingAssignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.coachId == request.auth.uid);
      allow update: if isAuthenticated() && (isAdmin() || resource.data.coachId == request.auth.uid || resource.data.playerId == request.auth.uid);
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.coachId == request.auth.uid);
    }
    
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.coachId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.coachId == request.auth.uid);
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated();
    }
    
    // Everything else defaults to Admin-only
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
